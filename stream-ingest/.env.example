# stream-ingest — environment reference. Copy to .env and fill in. Never commit .env.
#
# Keys declared in config/instance-schema.mjs can also be set in the Admin Panel; the env wins
# when both are set. The owner bot plugin's own tuning knobs belong to that plugin and are not
# listed here.

# ── Required ──────────────────────────────────────────────────────────────────────────────
# stream-api, no default (the process exits at boot without it). The socket URL is derived
# from it (http→ws); set STREAM_WS_URL only if the socket lives elsewhere.
STREAM_API_URL=http://127.0.0.1:3001
# STREAM_WS_URL=
# The same value as stream-api's STREAM_API_SECRET.
STREAM_API_SECRET=
SITE_NAME=Example Stream
SITE_ORIGIN=https://example.tv
BOT_MATRIX_ID=@bot:example.tv

# ── Which platform chats to read ──────────────────────────────────────────────────────────
# Comma list of twitch, kick, youtube, streamplace, or "none". Unset or empty = the platforms the
# settings set up: each one whose channel is set, and YouTube only while its switch is on (the
# setup pages / Admin Panel). The boot line says which.
PLATFORMS=none
# The YouTube switch (off on a fresh install; 1 = on). Not consulted while PLATFORMS is set.
# MODULE_YOUTUBE=

# ── Twitch ────────────────────────────────────────────────────────────────────────────────
# TWITCH_CHANNEL=
# TWITCH_BROADCASTER_ID=
# The bot account that reads/writes chat, and its token (WITHOUT "oauth:"), chat:read+chat:edit.
# TWITCH_BOT_USERNAME=
# TWITCH_OAUTH_TOKEN=
# TWITCH_REFRESH_TOKEN=
# TWITCH_TOKEN_STATE_PATH=
# The Twitch app (client id + secret): live status when no bot account is signed in. Usually
# saved on the setup page instead.
# TWITCH_OAUTH_CLIENT_ID=
# TWITCH_OAUTH_CLIENT_SECRET=

# ── YouTube ───────────────────────────────────────────────────────────────────────────────
# YOUTUBE_CHANNEL_ID=
# The API key finds the live video and resolves chatters' channel ids.
# YOUTUBE_API_KEY=
# YOUTUBE_READ_MODE=
# YOUTUBE_CHAT_MODE=
# YOUTUBE_API_POLL_MS=
# YOUTUBE_ID_BACKFILL_MS=120000
# YOUTUBE_VIDEO_ID=
# YT_INNERTUBE_VIEWERS=

# ── Kick ──────────────────────────────────────────────────────────────────────────────────
# KICK_CHANNEL_SLUG=
# Override if Kick's bot protection blocks the id lookup — set BOTH (chat needs the channel id
# for the realtime descriptor; a chatroom id alone still triggers the lookup). Usually saved in
# the Admin Panel instead ("Kick chatroom id" / "Kick channel id").
# KICK_CHANNEL_ID=
# KICK_CHATROOM_ID=
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=
# Silence (ms) before the Kick socket is treated as dead; default: two server pings + 15 s.
# KICK_STALE_MS=

# ── stream.place ──────────────────────────────────────────────────────────────────────────
# The channel's DID (did:plc:…).
# STREAMPLACE_STREAMER_DID=
# STREAMPLACE_STALE_MS=

# ── Viewer poll / stream lifecycle (lib/poller.js) ───────────────────────────────────────
# A session opens when any configured platform is live and closes once every one is offline.
# Poll interval while live, and while nothing is (must stay larger).
# VIEWER_POLL_MS=60000
# VIEWER_IDLE_POLL_MS=180000
# 0 = no poller (no sessions, no viewer snapshots).
# POLLER_ENABLED=1

# ── Health (GET /health — every chat reader's state; the bundle's healthcheck reads it) ──
# INGEST_HEALTH_PORT=3010
# 0.0.0.0 by default (the bundle's network); 127.0.0.1 on a host install.
# INGEST_HEALTH_BIND=127.0.0.1

# ── Chat behaviour ────────────────────────────────────────────────────────────────────────
# Names treated as bots (comma list, lowercase): logged but never scored.
# BOT_USERNAMES=nightbot,streamelements
# Reply to !karma / !rank / !dono and the pronoun commands in platform chat.
ENABLE_COMMANDS=1
# What !dono posts. Unset = SITE_ORIGIN/donate while a payment provider (Stripe or PayPal) is on,
# else DONATE_URL (https only), else "donations aren't set up here".
# DONO_LINKS=
# An outside donate page (Ko-fi, PayPal.me …) for when no provider is set up here.
# DONATE_URL=
# INGEST_DELIVERY_CONCURRENCY=
# INGEST_DELIVERY_MAX=
# INGEST_ENRICH_CONCURRENCY=
# INGEST_ENRICH_MAX=
# INGEST_SHED_AT=
# INGEST_CHAT_ALARM_AFTER=
# OPS_NOTIFY_ENABLED=

# ── AI (usually set in the Admin Panel instead) ──────────────────────────────────────────
# AI_MODE=simple
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# BOT_NAME=
# BOT_ENABLED=
# HELPDESK_ENABLED=
# AUTOMOD_ENABLED=
# AUTOMOD_CATEGORIES=
# AUTOMOD_MIN_CONFIDENCE=
# MEMORY_ENABLED=
# MEMORY_MIN_WORDS=
# Offline scripts only (bulk backfills); the service itself reaches the database through stream-api.
# DATABASE_URL=
