# Black Branch — /opt/blackbranch/.env, the ONE place an install's values and bootstrap secrets
# live. install.sh writes the real file once, with a random value for every secret,
# mode 600; this example only shows its shape. Every secret below is a placeholder.

# ── Bundle ──
COMPOSE_PROJECT_NAME=blackbranch
# Tunnel mode: just compose.yaml. Direct/internal: add compose.public.yaml (caddy takes 80/443);
# internal (lab) also compose.lab.yaml (the apps trust caddy's own CA).
COMPOSE_FILE=/opt/blackbranch/compose.yaml
# "tunnel" starts cloudflared; empty in direct/internal mode.
COMPOSE_PROFILES=tunnel
# Where the install lives (the recovery sheet names its .env).
BB_HOME=/opt/blackbranch
BB_DOMAIN=example.com
# tunnel | direct | internal (internal = LAB ONLY: caddy's own CA, not for production)
BB_TLS_MODE=tunnel
BB_ACME_EMAIL=
CLOUDFLARE_TUNNEL_TOKEN=
# The bundle network, cloudflared's fixed address in it (the only proxy caddy trusts), and caddy's
# (the only proxy stream-api believes about a viewer's address). Change all three together.
BB_SUBNET=172.29.83.0/24
BB_CLOUDFLARED_IP=172.29.83.250
BB_CADDY_IP=172.29.83.249

# ── Updates ────────────
# The release this box runs; its images carry it as their tag (`blackbranch up` keeps it in step).
BB_RELEASE=local
# The ONE key this box trusts to sign a release — the one it was installed with; never changed.
BB_RELEASE_KEY=ed25519:4N1ZGxwrGybbUuF2VppZg/svE8p788wV+A/d4znKu5Y=
# Where releases are announced (<feed>/<channel>.json), and which channel: stable or beta.
BB_UPDATE_FEED=https://blackbranch.app/releases
BB_UPDATE_CHANNEL=stable
# The last .env migration applied (install/migrations/).
BB_ENV_VERSION=4

# ── Identity (permanent: the Matrix server name and the origins never change) ──
SITE_ORIGIN=https://example.com
SITE_API_ORIGIN=https://api.example.com
SITE_API_WS_ORIGIN=wss://api.example.com
MATRIX_SERVER_NAME=example.com
MATRIX_HOMESERVER_URL=https://matrix.example.com
MATRIX_OAUTH_ISSUER=https://matrix.example.com/auth/
MATRIX_OAUTH_CLIENT_ID=00000000000000000000000000

# ── Display values (read by the site when it starts; change with `blackbranch set <KEY> <value>`) ──
SITE_NAME="Example Stream"
SITE_SHORT_NAME=
SITE_TAGLINE=
SITE_DESCRIPTION=
SITE_HOME_HEADING=
SITE_HOME_INTRO=
SITE_ICON_SET=
LEGAL_OPERATOR=
LEGAL_CONTACT_EMAIL=
LEGAL_GOVERNING_LAW=
LEGAL_EFFECTIVE_DATE=
CURRENCY_NAME=
CURRENCY_NAME_PLURAL=
CURRENCY_SYMBOL=
CURRENCY_ICON=
COMMUNITY_SCORE_NAME=
YOUTUBE_VOD_PLAYLIST=none

# ── Secrets (install.sh: random, never printed) ──
POSTGRES_PASSWORD=change-me
STREAM_DB_PASSWORD=change-me
SYNAPSE_DB_PASSWORD=change-me
MAS_DB_PASSWORD=change-me
STREAM_API_SECRET=change-me
AUTH_SECRET=change-me
TOKEN_ENC_KEY=change-me
INSTANCE_MASTER_KEY=change-me
MATRIX_OAUTH_CLIENT_SECRET=change-me
MAS_SYNAPSE_SECRET=change-me
MAS_ENCRYPTION_SECRET=change-me
SYNAPSE_REGISTRATION_SECRET=change-me
SYNAPSE_MACAROON_SECRET=change-me
SYNAPSE_FORM_SECRET=change-me
BACKUP_PASSPHRASE=change-me

# ── First boot ──
# sha256 of the setup link's token (`blackbranch setup-link` prints the link); written by `blackbranch up`.
SETUP_TOKEN_HASH=
# The Forums tab's reader (a read-only chat account) signs in with this; `blackbranch up` makes it.
MATRIX_READER_TOKEN=

# ── Alerts from the server (`sudo blackbranch alerts test` sends a test one) ──
# An ntfy topic address (https://ntfy.sh/<a private topic>), and/or a command that sends an email it
# reads on its input, headers first: sendmail you@example.com. Neither set: alerts are in the
# server's log only. Never printed; kept here only.
BB_ALERT_NTFY_URL=
BB_ALERT_EMAIL_COMMAND=
