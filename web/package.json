{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "//browserslist": "Modern targets (browsers from ~2022 that natively support Array.at/flat/flatMap, Object.fromEntries/hasOwn, String.trimStart/End) so Next stops shipping legacy polyfills for them. Safari 15.4 is the binding constraint (Object.hasOwn). This audience is on current devices. — these are the JS targets; the CSS baseline is Tailwind 4's (Chrome 111 / Safari 16.4 / Firefox 128), which the @property registrations in app/globals.css rely on.",
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "scripts": {
    "dev": "next dev",
    "check:prepaint": "node scripts/check-prepaint.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check:types": "tsc --noEmit",
    "build": "npm run check:all && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test \"app/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "check:layering": "node scripts/check-layering.mjs",
    "check:device-queries": "node scripts/check-device-queries.mjs",
    "check:orphans": "node scripts/check-orphans.mjs",
    "check:chrome": "node scripts/check-chrome.mjs",
    "check:owner-literals": "node ../tools/check-owner-literals.mjs web",
    "check:instance-schema": "node ../tools/gen-instance-schema.mjs --check web",
    "check:all": "npm run check:prepaint && npm run check:tokens && npm run check:structure && npm run check:layering && npm run check:device-queries && npm run check:orphans && npm run check:chrome && npm run check:owner-literals && npm run check:owner-seam && npm run check:instance-schema && npm run check:types && npm run lint",
    "audit:client-boundary": "node scripts/check-client-boundary.mjs",
    "check:owner-seam": "node ../tools/check-owner-seam.mjs web"
  },
  "dependencies": {
    "@atproto/api": "^0.20.15",
    "@atproto/oauth-client-node": "^0.4.1",
    "@mozilla/readability": "^0.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "hls.js": "^1.6.16",
    "jsdom": "^29.1.1",
    "matrix-js-sdk": "^41.6.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.5",
    "stripe": "^22.3.0",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
