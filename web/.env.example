# web — environment reference. Copy to .env.local and fill in. Never commit .env.local.
#
# This file is read at BUILD time as well as at run time. `next build` resolves the
# install values below (SITE_*, MATRIX_*, LEGAL_*, CURRENCY_* …) and bakes them into the pages
# and browser bundles; at boot the server refuses to start if its run-time env names a
# DIFFERENT value for one of them. Change one = rebuild. Every key here is declared once in
# config/instance-schema.mjs (label, meaning, default); most can also be edited in the Admin
# Panel instead of here — the env wins when both are set.
#
# Database: web takes ONE connection string, DATABASE_URL. stream-api takes the same database as
# separate DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD (see stream-api/.env.example).

# ── Required: run time ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://streamer:CHANGE_ME@127.0.0.1:5432/stream
# Session cookie signing secret (any long random string). AUTH_SECRET_1..3 = older ones still accepted.
AUTH_SECRET=
# 64 hex characters — encrypts linked platform tokens at rest.
TOKEN_ENC_KEY=
# stream-api, server to server (no default — the server refuses to start without it).
STREAM_API_URL=http://127.0.0.1:3001
# Optional: stream-api's internal socket for live settings changes. Unset = STREAM_API_URL with
# http→ws (same process and port). Set it only if the socket lives elsewhere.
# STREAM_API_WS_URL=ws://127.0.0.1:3001
# The same value as stream-api's STREAM_API_SECRET.
STREAM_API_SECRET=

# ── Required: install values (build) ──────────────────────────────────────────────────────
SITE_NAME=Example Stream
# The public origin. Sign-in uses it too: next-auth's own URL (AUTH_URL) is set from it at boot
# when AUTH_URL is unset — you do not need both.
SITE_ORIGIN=https://example.tv
SITE_API_ORIGIN=https://api.example.tv
SITE_API_WS_ORIGIN=wss://api.example.tv
MATRIX_SERVER_NAME=example.tv
MATRIX_HOMESERVER_URL=https://matrix.example.tv
MATRIX_OAUTH_ISSUER=https://auth.example.tv/
MATRIX_OAUTH_CLIENT_ID=
MATRIX_OAUTH_CLIENT_SECRET=
# MATRIX_FEDERATION_SERVER=
# Only for a homeserver that already holds the site's Matrix data under an older prefix (readers
# then accept both names). A fresh install leaves it unset.
# MATRIX_LEGACY_NAMESPACE=
# Instance settings, normally set from the Admin Panel (Site → Community server); env overrides.
# Federation (default off) is applied by the install bundle's host command, which reads the database
# row; so is sign-up on the bundled homeserver (open|closed; always closed while setup runs). The
# two room ids are written by its homeserver bootstrap.
# MATRIX_FEDERATION=
# MATRIX_REGISTRATION=
# Sign-in with an account on another Matrix server: off | on | allowlist (default off — only this
# site's own server). The two lists are server names, comma-separated, matched exactly; the deny
# list applies in every mode. Usually set in the Admin Panel (Site → Sign-in from other servers).
# AUTH_FEDERATED_SIGNIN=
# AUTH_FEDERATED_ALLOW=
# AUTH_FEDERATED_DENY=
# Only where MAS's admin API is not under the issuer: the bundle serves it on MAS's internal
# listener (http://mas:8081/api/admin/v1). Unset = <issuer>/api/admin/v1.
# MAS_ADMIN_URL=
# MATRIX_HUB_ROOM_ID=
# MATRIX_GENERAL_ROOM_ID=

# ── Legal pages (build) — yours to supply; unset shows "not set" on /legal and /about ────────
LEGAL_OPERATOR=
LEGAL_CONTACT_EMAIL=
# As it reads after "the laws of", e.g. "the State of X, United States".
LEGAL_GOVERNING_LAW=
# As written, e.g. "January 1, 2026".
LEGAL_EFFECTIVE_DATE=
# The liability cap the Terms name, in US dollars (better set in the Admin Panel → Site → Legal). Unset = 50.
# LEGAL_LIABILITY_CAP_USD=

# ── Optional: how the site presents itself (build) ────────────────────────────────────────
# SITE_DESCRIPTION=
# SITE_SHORT_NAME=
# SITE_TAGLINE=
# SITE_HOME_HEADING=
# SITE_HOME_INTRO=
# A folder under public/ holding icon.png, icon-192.png, icon-512.png, icon-maskable-512.png,
# apple-touch-icon.png. Unset = the built-in neutral icons (public/brand).
# SITE_ICON_SET=/brand/mine
# Only for a site that stored its own platform id and browser storage names under an older word
# before the product names (old values are carried forward). A fresh install leaves it unset.
# SITE_LEGACY_ID=
# Points: names, symbol, icon (unset = "point" / "points" / "pts" / the built-in coin).
# CURRENCY_NAME=
# CURRENCY_NAME_PLURAL=
# CURRENCY_SYMBOL=
# CURRENCY_ICON=
# COMMUNITY_SCORE_NAME=
# Discord bridge (only with the bridge module).
# DISCORD_BRIDGE_USERNAME_TEMPLATE=
# DISCORD_BRIDGE_DISPLAYNAME_TEMPLATE=

# ── People ────────────────────────────────────────────────────────────────────────────────
STREAMER_DISPLAY_NAME=
STREAMER_MATRIX_ID=@streamer:example.tv
BOT_MATRIX_ID=@bot:example.tv
# STAFF_EXTRA_MATRIX_IDS=
# BOT_NAME=
# The forum reader: a Matrix account + token the server reads public rooms with.
MATRIX_READER_TOKEN=
MATRIX_READER_USER_ID=@reader:example.tv

# ── Platforms (each optional; leave a platform's lines out to leave it off) ──────────────
# TWITCH_CHANNEL=
# TWITCH_BROADCASTER_ID=
# TWITCH_OAUTH_CLIENT_ID=
# TWITCH_OAUTH_CLIENT_SECRET=
# MODULE_YOUTUBE=   (the YouTube switch: off on a fresh install; 1 = on)
# MODULE_RADIO=     (the radio switch, owner plugin only: the player offers its Radio tab while on)
# YOUTUBE_CHANNEL_ID=
# "none" or unset = no VODs card and no VODs tabs.
# YOUTUBE_VOD_PLAYLIST=none
# YOUTUBE_API_KEY=
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# KICK_CHANNEL_SLUG=
# KICK_USER_ID=
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=
# STREAMPLACE_STREAMER_DID=
# SP_CHANNEL=
# The player's live sources switched off (native, streamplace, youtube, twitch; comma-separated).
# Usually switched in the Stream tab instead. Empty = all on.
# PLAYER_EMBEDS_OFF=
# STREAMPLACE_HOST_SUFFIX=
# ATPROTO_PRIVATE_JWK=
# STREAM_TITLE=
# STREAMER_AVATAR_URL=
# STREAMER_MEDIA_TOKEN=

# ── Payments (each optional) ──────────────────────────────────────────────────────────────
# Stripe and PayPal are module switches (off on a fresh install; 1 = on). Better set in the
# Admin Panel → Site → Modules; a value here wins. A database built by the migration chain keeps
# an unset switch ON (the upgrade fail-safe).
# MODULE_STRIPE=
# MODULE_PAYPAL=
# The publishable key is a setting (the Stripe setup page) the browser asks for at run time;
# STRIPE_PUBLISHABLE_KEY overrides it, and an older build's NEXT_PUBLIC_ copy is still read.
# STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=   (a restricted rk_ key: the permissions are on the Stripe setup page)
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_SUPPORTER=
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_PLANS=                 # {"supporter":"P-…"}: the PayPal billing plan per tier; set = subscriptions can be paid through PayPal (Admin Panel → PayPal)
# Where Subscribe goes when Stripe is not set up; unset = no Subscribe button without Stripe.
# SUBSCRIBE_URL=
# DONATE_URL=/donate

# ── Points and automod tuning (usually edited in the Admin Panel instead) ─────────────────
# CURRENCY_PURCHASABLE=
# CURRENCY_EARN_FIRST_MESSAGE=
# CURRENCY_EARN_MESSAGE=
# CURRENCY_EARN_MESSAGE_COOLDOWN_MINUTES=
# CURRENCY_EARN_VOTE_CAST=
# CURRENCY_EARN_VOTES_PER_STREAM=
# CURRENCY_EARN_UPVOTE_RECEIVED=
# CURRENCY_EARN_PAID_UPVOTES_PER_VOTER=
# CURRENCY_EARN_WATCH_CAP=
# CURRENCY_EARN_WATCH_MINUTES_PER_POINT=
# CURRENCY_EARN_CLOCK_MULTIPLIER=
# AUTOMOD_ENABLED=
# AUTOMOD_HOLD_BUDGET_MS=
# AUTOMOD_SKIP_SUPPORTERS=
# CLIENT_ERROR_ALARM_BURST=

# ── First boot and running the site ──────────────────────────────────────────────────────
# A bundle install's setup link: the sha256 of its token. Set = the site shows only its setup pages
# until setup.completedAt exists. Unset (a source checkout, an install set up by hand) = never gated.
# SETUP_TOKEN_HASH=
# SETUP_COMPLETED_AT=          (normally a settings row the setup pages write)
# What the setup pages' recovery sheet shows once (the bundle passes both).
# BACKUP_PASSPHRASE=
# BB_ENV_FILE=/opt/blackbranch/.env
# Where the site drops requests for the host and reads the answers (the bundle mounts both).
# BB_REQUESTS_DIR=/requests
# BB_RESULTS_DIR=/request-results
# The port this server listens on (the request proxy asks it for the setup state).
# PORT=3000
# The on-device diagnostic URL switches (?kbdebug, ?backdebug, ?playerdebug, ?chipdebug) are left out
# of a production build; 1 at BUILD time keeps them in (app/lib/debugFlags.ts).
# NEXT_PUBLIC_DEBUG_FLAGS=
# SITE_TIME_ZONE=
# SITE_DATA_SINCE=
# UPDATES_QUIET_HOUR=
# BUG_REPORTS_ENABLED=
# Where backups go (better set in the setup pages or the Admin Panel → Site → Backups; the
# server's backup job reads them, the site only shows them).
# BACKUP_TARGET=local
# BACKUP_REPOSITORY=
# BACKUP_S3_REGION=
# BACKUP_KEEP_DAILY=
# BACKUP_KEEP_WEEKLY=
