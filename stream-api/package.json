  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Black-Branch/blackbranch.git",
    "directory": "stream-api"
  },
  "description": "The site's live backend: the chat hub and its WebSocket, the support and points ledger, alerts, overlays, read-aloud, OBS control, and the API the chat service and the site call.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "node --test",
    "lint": "eslint",
    "check:orphans": "node ../tools/check-orphans.mjs stream-api",
    "check:owner-literals": "node ../tools/check-owner-literals.mjs stream-api",
    "check:all": "npm run lint && npm run check:orphans && npm run check:owner-literals && npm run check:owner-seam && npm run check:instance-schema",
    "check:instance-schema": "node ../tools/gen-instance-schema.mjs --check stream-api",
    "check:owner-seam": "node ../tools/check-owner-seam.mjs stream-api"
  },
  "dependencies": {
    "express": "^4.18.2",
    "obs-websocket-js": "^5.0.8",
    "pg": "^8.11.3",
    "socket.io-client": "^4.8.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.10.0"
  }
}
