# stream-api — environment reference. Copy to .env and fill in. Never commit .env.
#
# The .env loader keeps the FIRST occurrence of a key: edit a value where it is, never append
# a second line for the same key further down (it would be ignored).
# Keys declared in config/instance-schema.mjs can also be set in the Admin Panel; the env wins
# when both are set. The owner bot plugin's own env names (its scenes, voices, folders) belong to
# that plugin and are not listed here.
#
# Database: stream-api takes the database as separate DB_* values. web (and the offline
# scripts here) take one DATABASE_URL instead — the same database, two spellings.

# ── Required ──────────────────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=stream
DB_USER=streamer
DB_PASSWORD=
# DB_POOL_MAX=20
# The offline scripts here (bulk-embed*.js, bulk-score-intelligence.js) also accept one URL:
# DATABASE_URL=
# Shared secret every internal caller (web, stream-ingest) presents. Enforced unless
# STREAM_API_ENFORCE=0; enforcing with no secret is a startup fatal.
STREAM_API_SECRET=
# STREAM_API_ENFORCE=1
# 64 hex characters — encrypts the credentials saved in the Admin Panel.
INSTANCE_MASTER_KEY=
MATRIX_SERVER_NAME=example.tv
BOT_MATRIX_ID=@bot:example.tv

# ── Listening ─────────────────────────────────────────────────────────────────────────────
# STREAM_API_PORT=3001
# STREAM_API_HOST=0.0.0.0
# MAX_WS_CLIENTS=
# MAX_WS_PER_ADDRESS=
# WS_TRUSTED_PROXIES=
# Sockets kept free under MAX_WS_CLIENTS for overlays on the local network (default 64).
# WS_LOCAL_RESERVE=
# WS_MAX_BUFFERED=
# WS_MAX_PAYLOAD=
# SHUTDOWN_GRACE_MS=

# ── Files ─────────────────────────────────────────────────────────────────────────────────
# RADIO_MEDIA_DIR=
# TTS_TMP_DIR=

# ── AI and voice (usually saved in the Admin Panel instead) ──────────────────────────────
# AI_MODE=simple
# BOT_NAME=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=
# ELEVENLABS_OUTPUT_FORMAT=
# ELEVENLABS_VOICE_CASUAL=
# ELEVENLABS_VOICE_LOUD=
# ALERT_TTS_ENABLED=0
# TTS_SINK=
# TTS_DUAL_VOICE=
# TTS_CLIPS_DIR=
# TTS_MAX_TURN_MS=
# RADIO_DJ_AUTO=
# RADIO_DJ_PLAY=
# AUTOMOD_ENABLED=
# AUTOMOD_CATEGORIES=
# AUTOMOD_MIN_CONFIDENCE=
# AUTOMOD_HOLD_BUDGET_MS=
# AUTOMOD_MARK_AFTER_COUNT=
# AUTOMOD_MARK_AFTER_HOURS=
# AUTOMOD_HOLD_EXPIRY=
# MEMORY_ENABLED=
# MEMORY_RETENTION_DAYS=

# ── Platforms ─────────────────────────────────────────────────────────────────────────────
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_OAUTH_CLIENT_ID=
# TWITCH_OAUTH_CLIENT_SECRET=
# YOUTUBE_API_KEY=
# YOUTUBE_MEMBERSHIP_USD=
# Optional JSON map of membership LEVEL NAME (as the banner shows it) → gross USD, e.g. {"Level A": 4.99, "Level B": 9.99}.
# An unknown or missing level is credited at YOUTUBE_MEMBERSHIP_USD, with a log line.
# YOUTUBE_MEMBERSHIP_TIERS=
# KICK_SUB_USD=
# KICK_USD_PER_KICK=

# ── Money webhooks (each optional) ────────────────────────────────────────────────────────
# KOFI_VERIFICATION_TOKEN=
# PATREON_WEBHOOK_SECRET=
# STREAMLABS_SOCKET_TOKEN=
# SUPPORT_REMINDER_MIN=

# ── Modules (each off on a fresh install; 1 = on). Better set in the Admin Panel → Site →
#    Modules; a value here wins over the panel. Applies at the next restart. ─────────────────
# MODULE_OBS=
# MODULE_LIGHTS=
# MODULE_METER=
# MODULE_RADIO=

# ── OBS (optional — the obs module; scenes and sources are found BY NAME) ─────────────────
#    The rig page (one browser source, Admin Panel → Utility → OBS) needs nothing here.
#    OBS_WS_URL adds the OBS WebSocket for a server on OBS's own network; unset = none.
#    OBS_WS_URL and HA_URL are env ONLY (never the Admin Panel): each is where a credential goes.
#    OBS_RIG_KEY_VERSION pins the rig page key's generation (Regenerate then changes nothing).
# OBS_WS_URL=ws://127.0.0.1:4455
# OBS_RIG_KEY_VERSION=
# OBS_WS_PASSWORD=
# OBS_AUDIO_SCENE=
# OBS_SOUND_SOURCE=
# OBS_BOT_SCENE=
# OBS_BOT_SOURCE=
# OBS_BOT_SHOW_SCENE=
# TIMER_PAUSE_SCENE=
# TIMER_TZ=
# SOUNDS_ENABLED=

# ── Audio satellite (optional — plays sounds on another machine) ─────────────────────────
# AUDIO_SATELLITE_URL=
# SATELLITE_PORT=
# SATELLITE_ALLOW=
# SATELLITE_PLAY_CMD=
# SATELLITE_MAX_PLAY_MS=

# ── Room lights (optional — Home Assistant) ───────────────────────────────────────────────
# HA_LIGHTS_ENABLED=0
# HA_URL=
# HA_TOKEN=
# HA_LIGHT_ENTITIES=
# HA_TIMEOUT_MS=
# HA_FLASH_HOLD_MS=
# HA_RAID_STAGGER_MS=
# HA_MONEY_MIN_USD=
# HA_MONEY_BIG_USD=
# HA_MONEY_HOLD_MS=
# HA_MONEY_POP_K=
# HA_MONEY_POP_MS=
# HA_MONEY_RGB=
# HA_AMBIENT_ENABLED=
# HA_AMBIENT_STEP_MS=
# HA_AMBIENT_PERIOD_MS=
# HA_AMBIENT_SAT_PERIOD_MS=
# HA_AMBIENT_HUE_A=
# HA_AMBIENT_HUE_B=
# HA_AMBIENT_SAT_A=
# HA_AMBIENT_SAT_B=
# HA_AMBIENT_BRIGHTNESS_PCT=
# HA_AMBIENT_PHASE_OFFSET=

# ── Backups: a bucket's keys (usually saved in the setup pages or the Admin Panel; the server's
# backup job reads them through this package's settings code, the site never does) ───────
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

# ── Alerts to whoever runs the site (ntfy) ────────────────────────────────────────────────
# Optional. One topic is enough (both kinds of alert go to it); two give urgent and quiet alerts
# their own subscriptions. With none, problems stay visible in the Admin Panel's Doctor.
# NTFY_WAKE_URL=
# NTFY_QUIET_URL=
# OPS_NOTIFY_ENABLED=
# OPS_NOTIFY_COOLDOWN_MS=
# OPS_NOTIFY_TIMEOUT_MS=
